' ==================== Base Classes ====================

package "ast.node" {
    abstract class ASTNode {
        # nodeName: String
        # lineNumber: int
        # columnNumber: int
        # parent: ASTNode
        --
        + ASTNode(nodeName, lineNumber, columnNumber)
        + getNodeName(): String
        + getLineNumber(): int
        + getColumnNumber(): int
        + getParent(): ASTNode
        + setParent(parent: ASTNode): void
        + {abstract} accept(visitor: ASTVisitor<T>): T
        + {abstract} getChildren(): List<ASTNode>
        # getExtraInfo(): String
        + toString(indent: int): String
    }
}

package "ast.visitor" {
    interface ASTVisitor<T> {
        + visit(ProgramNode): T
        + visit(StatementNode): T
        + visit(ExpressionNode): T
        + visit(TemplateNode): T
        + ...70+ visit methods
    }
}

ASTNode ..> ASTVisitor : uses

' ==================== Python AST ====================

package "ast.python" <<Rectangle>> {

    class ProgramNode {
        - statements: List<StatementNode>
        --
        + ProgramNode(lineNumber: int)
        + addStatement(statement: StatementNode): void
        + getStatements(): List<StatementNode>
        + getStatementCount(): int
    }

    abstract class StatementNode {
        + StatementNode(nodeName, lineNumber, columnNumber)
        + StatementNode(nodeName, lineNumber)
    }

    abstract class ExpressionNode {
        + ExpressionNode(nodeName, lineNumber, columnNumber)
        + {abstract} toValueString(): String
    }

    abstract class ParameterNode {
        # name: String
        # defaultValue: ExpressionNode
        --
        + getName(): String
        + hasDefaultValue(): boolean
        + getDefaultValue(): ExpressionNode
    }
}


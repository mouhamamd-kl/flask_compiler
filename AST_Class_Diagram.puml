' ==================== Python Expressions - Operations ====================

package "ast.python.expressions.operations" <<Rectangle>> {

    class BinaryOpNode {
        - operator: Operator
        - left: ExpressionNode
        - right: ExpressionNode
        --
        + getOperator(): Operator
        + getLeft(): ExpressionNode
        + getRight(): ExpressionNode
    }

    class UnaryOpNode {
        - operator: Operator
        - operand: ExpressionNode
        --
        + getOperator(): Operator
        + getOperand(): ExpressionNode
    }

    class ComparisonNode {
        - operator: Operator
        - left: ExpressionNode
        - right: ExpressionNode
        --
        + getOperator(): Operator
        + getLeft(): ExpressionNode
        + getRight(): ExpressionNode
    }

    class LogicalOpNode {
        - operator: Operator
        - left: ExpressionNode
        - right: ExpressionNode
        --
        + getOperator(): Operator
        + getLeft(): ExpressionNode
        + getRight(): ExpressionNode
    }

    enum "BinaryOpNode.Operator" as BinaryOp {
        ADD, SUB, MUL, DIV
        MOD, FLOOR_DIV, POW
    }

    enum "UnaryOpNode.Operator" as UnaryOp {
        PLUS, MINUS
    }

    enum "ComparisonNode.Operator" as CompOp {
        EQ, NEQ, LT, GT
        LTE, GTE, IN, NOT_IN
    }

    enum "LogicalOpNode.Operator" as LogicOp {
        AND, OR, NOT
    }
}

